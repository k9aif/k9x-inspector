# K9X Inspector — single container: FastAPI (API + UI), the inspection worker and scheduler.
# k9-aif installs from PyPI (requirements.txt). Settings come from .env at run time.
# runtime/ (inspector.db, repository clones) is a mounted volume — see build-run.sh.
FROM registry.access.redhat.com/ubi9/python-311:latest
USER root
RUN dnf install -y git && dnf clean all
WORKDIR /app
COPY requirements.txt .
# K9AIF_LATEST (the latest k9-aif on PyPI, passed by build-run.sh) busts this layer's cache when a new
# framework release exists, so a rebuild always installs it; otherwise the cached layer is reused.
ARG K9AIF_LATEST=unknown
RUN echo "k9-aif latest on PyPI: ${K9AIF_LATEST}" \
 && pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir --upgrade -r requirements.txt
COPY . .
RUN mkdir -p /app/runtime && chown -R 1001:0 /app/runtime && chmod -R g+rwX /app/runtime
# Build identity for About and /api/health (the image has no .git). Last, so only this layer changes per build.
ARG INSPECTOR_COMMIT=unknown
ARG INSPECTOR_BUILT=unknown
ENV INSPECTOR_COMMIT=${INSPECTOR_COMMIT} INSPECTOR_BUILT=${INSPECTOR_BUILT}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    INSPECTOR_DB_PATH=/app/runtime/inspector.db INSPECTOR_WORKDIR=/app/runtime/repos
EXPOSE 8115
HEALTHCHECK --interval=30s --timeout=8s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8115/api/health')" || exit 1
USER 1001
CMD ["uvicorn", "inspector.api:app", "--host", "0.0.0.0", "--port", "8115", "--log-level", "info"]
