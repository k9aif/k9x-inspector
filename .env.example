# K9X Inspector — environment. Copy to .env; never commit .env.

# Sign-in. Admin: full control. Demo: read-only viewer shown on the sign-in page
# (may start inspections of public repositories, INSPECTOR_VIEWER_RUNS_PER_HOUR).
INSPECTOR_USER=admin
INSPECTOR_PASSWORD=
INSPECTOR_DEMO_USER=demo
INSPECTOR_DEMO_PASSWORD=demo
INSPECTOR_SESSION_SECRET=
INSPECTOR_VIEWER_RUNS_PER_HOUR=20

# Applications to track: name|https://github.com/owner/repo|branch|subfolder ; separated
INSPECTOR_APPS=EOC (Enterprise Insurance Operations Center)|https://github.com/k9aif/k9-aif-framework|main|examples/K9X_Enterprise_Insurance_OperationsCenter;ACME Health Insurance|https://github.com/k9aif/k9-aif-framework|main|examples/acme_health_insurance;ACME Support Center|https://github.com/k9aif/k9-aif-framework|main|examples/acme_support_center

# When to re-inspect: HH:MM daily, "every 6h" / "every 30m", or "off" (webhook and manual only).
# Scheduled passes skip applications whose branch has not moved.
INSPECTOR_SCHEDULE=every 6h

# GitHub push webhook (Settings > Webhooks: payload URL https://<host>/api/webhook/github,
# content type application/json, this secret, "Just the push event"). Empty = webhook off.
INSPECTOR_WEBHOOK_SECRET=

# Optional read-only token for private repositories (fine-grained, Contents: read).
INSPECTOR_GITHUB_TOKEN=

# Admins may inspect a folder on this server (development only; keep false when public).
INSPECTOR_ALLOW_LOCAL=false

INSPECTOR_PORT=8115
INSPECTOR_MAX_REPO_MB=200
TZ=America/New_York
